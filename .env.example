# ==============================================================================
# QUANNGUYENS — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# HỆ THỐNG AI AGENT CSKH 24/7 — QUANNGUYENS — QUANNGUYENS.COM
# ==============================================================================

# ── RUNTIME CƠ BẢN ─────────────────────────────────────────────
NODE_ENV=production
PORT=3002
TIMEZONE=Asia/Ho_Chi_Minh
CURRENCY=VND

# ── ĐỊNH DANH HỆ THỐNG ─────────────────────────────────────────
DEFAULT_TENANT_ID=quannguyens_corp
DEFAULT_SHOP_ID=quannguyens_pijama

# ── CƠ SỞ DỮ LIỆU SQLITE NATIVE ────────────────────────────────
# Mo truong local (development): ./data/cskh.db
# Render Persistent Disk (production): /data/cskh.db
# Render Free Plan KHONG ho tro disk mount -- can Starter Plan (\/thang)
CSKH_DB_PATH=./data/cskh.db

# ── BẢO MẬT & MÃ HÓA NỘI BỘ (Chuỗi Hex ngẫu nhiên ít nhất 32 byte) ─
CSKH_CONFIRMATION_SECRET=your_32_byte_hex_secret_here
CSKH_ADMIN_SECRET=your_32_byte_hex_admin_secret_here
CSKH_WEBHOOK_SECRET=your_32_byte_hex_webhook_secret_here

# ── KẾT NỐI SERVER BÁN HÀNG UPSTREAM (Tùy chọn) ────────────────
SHOP_API_BASE_URL=http://localhost:3001
SHOP_API_TOKEN=

# ── 1. GOOGLE GEMINI AI (Trí tuệ nhân tạo tạo sinh cho QuanNguyenS) ────
# Lấy API key tại: https://aistudio.google.com/ (Gói Free Tier vĩnh viễn)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
GROQ_API_KEY=
OPENROUTER_API_KEY=

# ── 2. META PLATFORM — FACEBOOK FANPAGE & MESSENGER ────────────
# Tạo App và Webhook tại: https://developers.facebook.com/
# Callback URL Webhook: https://your-domain-or-tunnel/api/webhook/meta
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=quannguyens_meta_verify_token_2026
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=

# ── 3. META PLATFORM — INSTAGRAM DIRECT MESSAGES ───────────────
# Bật Instagram Graph API trong Meta App
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=

# ── 4. THREADS API ─────────────────────────────────────────────
# Đăng ký quyền Threads API tại Meta Developer Portal
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# ── 5. ZALO OFFICIAL ACCOUNT (Zalo OA OpenAPI v3.0) ────────────
# Quản lý tại: https://developers.zalo.me/
# Callback Webhook: https://your-domain-or-tunnel/api/webhook/zalo
ZALO_OA_ID=
ZALO_APP_ID=
ZALO_SECRET_KEY=
ZALO_ACCESS_TOKEN=
ZALO_REFRESH_TOKEN=

# ── 6. THÔNG TIN TRUYỀN THÔNG & MẠNG XÃ HỘI CHÍNH THỨC ────────
BRAND_WEBSITE=https://quannguyens.com
BRAND_FACEBOOK=https://facebook.com/qns.style
BRAND_INSTAGRAM=https://instagram.com/qns.style
BRAND_TIKTOK=https://www.tiktok.com/@qns.style?lang=vi-VN

# ── 7. TÀI KHOẢN THANH TOÁN VIETCOMBANK & VIETQR (100% FREE TRỌN ĐỜI) ──
# Tạo QR QuickLink tự động miễn phí vĩnh viễn qua VietQR API
VIETQR_BANK_ID=VCB
VIETQR_BIN=970436
VIETQR_ACCOUNT_NO=1050773506
VIETQR_ACCOUNT_NAME=NGUYEN DUC QUAN

# Tùy chọn xác thực tự động qua SePay (nếu có sử dụng webhook ngân hàng)
SEPAY_WEBHOOK_API_KEY=

# ── 8. GOOGLE SHEETS LIVE SYNC & CHĂM SÓC SAU NHẬN HÀNG (100% FREE) ─
# Dán ID Google Sheet của bạn vào đây (VD: 1nHKbTYU2woXvBaf5m5B7w4N4DO7MLACp0gyb32BQyPg)
GOOGLE_SHEET_ID=
# Hoặc dán trực tiếp link CSV Export nếu có
GOOGLE_SHEET_CSV_URL=
GOOGLE_SHEET_RANGE=A1:Z500
GOOGLE_SHEET_WEBHOOK_SECRET=quannguyens_sheets_secret_2026
GOOGLE_SHEET_POLL_INTERVAL_MS=30000
GOOGLE_SHEET_AUTO_SYNC=true

# ── 8.1. GOOGLE SERVICE ACCOUNT (KẾT NỐI TRỰC TIẾP SHEET RIÊNG TƯ) ──
# Cách 1: Đặt file JSON tải từ Google Cloud vào thư mục: credentials/google-service-account.json
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./credentials/google-service-account.json
# Cách 2: Hoặc điền trực tiếp email và private key nếu không dùng file:
GOOGLE_SERVICE_ACCOUNT_CLIENT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Cách 3: Hoặc dán toàn bộ chuỗi JSON của Service Account:
GOOGLE_SERVICE_ACCOUNT_JSON=

# ── 9. TỰ ĐỘNG HÓA CHĂM SÓC TOÀN VÒNG ĐỜI (OUTBOUND SCHEDULER) ──
# Bật tự động kiểm tra định kỳ 24/7 (hỏi thăm đơn hàng, nhắc nhở)
OUTBOUND_ENABLED=true
# Đã loại bỏ khung giờ yên tĩnh theo yêu cầu của Shop (chỉ bật nếu đặt true)
QUIET_HOURS_ENABLED=false
QUIET_HOURS_START=20:00
QUIET_HOURS_END=09:00
MARKETING_MAX_7D=1
MARKETING_MAX_30D=3
