# ==============================================================================
# QUANNGUYENS AI CSKH & MULTI-CHANNEL AGENT CONFIGURATION (.env.example)
# ==============================================================================

NODE_ENV=production
PORT=3002
TIMEZONE=Asia/Ho_Chi_Minh
CURRENCY=VND

# ── TENANT & SHOP IDENTIFICATION ─────────────────────────────
DEFAULT_TENANT_ID=quannguyens_corp
DEFAULT_SHOP_ID=quannguyens_pijama

# ── DATABASE & STORAGE ───────────────────────────────────────
CSKH_DB_PATH=./data/cskh.db

# ── SECURITY & TOKENS ────────────────────────────────────────
CSKH_CONFIRMATION_SECRET=[random-64-character-hex-string]
CSKH_ADMIN_SECRET=[random-64-character-hex-string]
CSKH_WEBHOOK_SECRET=[random-32-character-hex-string]

# ── UPSTREAM SHOP API (QuanNguyenS Web Platform) ─────────────
SHOP_API_BASE_URL=http://localhost:3001
SHOP_API_TOKEN=[internal-server-token-for-shop-api]

# ── LLM PROVIDERS (Gemini / Groq / OpenRouter) ───────────────
LLM_PROVIDER=gemini
GEMINI_API_KEY=[your-google-ai-studio-api-key]
GROQ_API_KEY=[your-groq-api-key]
OPENROUTER_API_KEY=[your-openrouter-api-key]

# ── META PLATFORM (Facebook Messenger, Instagram, Threads) ───
META_APP_ID=[your-meta-app-id]
META_APP_SECRET=[your-meta-app-secret]
META_VERIFY_TOKEN=[your-custom-webhook-verify-token]
META_PAGE_ID=[your-facebook-page-id]
META_PAGE_ACCESS_TOKEN=[your-facebook-page-access-token]

INSTAGRAM_ACCOUNT_ID=[your-instagram-business-account-id]
INSTAGRAM_ACCESS_TOKEN=[your-instagram-graph-api-token]

THREADS_USER_ID=[your-threads-user-id]
THREADS_ACCESS_TOKEN=[your-threads-api-token]

# ── ZALO OFFICIAL ACCOUNT (ZBS Template Messages) ────────────
ZALO_OA_ID=[your-zalo-oa-id]
ZALO_APP_ID=[your-zalo-app-id]
ZALO_SECRET_KEY=[your-zalo-secret-key]
ZALO_ACCESS_TOKEN=[your-zalo-oa-access-token]
ZALO_REFRESH_TOKEN=[your-zalo-oa-refresh-token]

# ── PAYMENT WEBHOOKS (SePay / Bank Transfer) ─────────────────
SEPAY_WEBHOOK_API_KEY=[your-sepay-webhook-api-key]

# ── OUTBOUND & SCHEDULER CONTROLS ────────────────────────────
OUTBOUND_ENABLED=false
QUIET_HOURS_START=20:00
QUIET_HOURS_END=09:00
MARKETING_MAX_7D=1
MARKETING_MAX_30D=3
