# ==============================================================================
# QUANNGUYENS — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# HỆ THỐNG AI AGENT CSKH 24/7 (MAY) — QUANNGUYENS.COM
# ==============================================================================

# ── RUNTIME CƠ BẢN ─────────────────────────────────────────────
NODE_ENV=production
PORT=3002
TIMEZONE=Asia/Ho_Chi_Minh
CURRENCY=VND

# ── ĐỊNH DANH HỆ THỐNG ─────────────────────────────────────────
DEFAULT_TENANT_ID=quannguyens_corp
DEFAULT_SHOP_ID=quannguyens_pijama

# ── CƠ SỞ DỮ LIỆU SQLITE NATIVE ────────────────────────────────
CSKH_DB_PATH=./data/cskh.db

# ── BẢO MẬT & MÃ HÓA NỘI BỘ (Chuỗi Hex ngẫu nhiên ít nhất 32 byte) ─
CSKH_CONFIRMATION_SECRET=your_32_byte_hex_secret_here
CSKH_ADMIN_SECRET=your_32_byte_hex_admin_secret_here
CSKH_WEBHOOK_SECRET=your_32_byte_hex_webhook_secret_here

# ── KẾT NỐI SERVER BÁN HÀNG UPSTREAM (Tùy chọn) ────────────────
SHOP_API_BASE_URL=http://localhost:3001
SHOP_API_TOKEN=

# ── 1. GOOGLE GEMINI AI (Trí tuệ nhân tạo tạo sinh cho May) ────
# Lấy API key tại: https://aistudio.google.com/
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
OPENROUTER_API_KEY=

# ── 2. META PLATFORM — FACEBOOK FANPAGE & MESSENGER ────────────
# Tạo App và Webhook tại: https://developers.facebook.com/
# Callback URL Webhook: https://your-domain-or-tunnel/api/webhook/meta
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=quannguyens_meta_verify_token_2026
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=

# ── 3. META PLATFORM — INSTAGRAM DIRECT MESSAGES ───────────────
# Bật Instagram Graph API trong Meta App
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=

# ── 4. THREADS API ─────────────────────────────────────────────
# Đăng ký quyền Threads API tại Meta Developer Portal
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# ── 5. ZALO OFFICIAL ACCOUNT (Zalo OA OpenAPI v3.0) ────────────
# Quản lý tại: https://developers.zalo.me/
# Callback Webhook: https://your-domain-or-tunnel/api/webhook/zalo
ZALO_OA_ID=
ZALO_APP_ID=
ZALO_SECRET_KEY=
ZALO_ACCESS_TOKEN=
ZALO_REFRESH_TOKEN=

# ── 6. THANH TOÁN TỰ ĐỘNG VIETQR & SEPAY WEBHOOK ───────────────
# Đăng ký SePay tại: https://my.sepay.vn/
# Webhook URL: https://your-domain-or-tunnel/api/webhook/sepay
SEPAY_WEBHOOK_API_KEY=
VIETQR_BANK_ID=MBBank
VIETQR_ACCOUNT_NO=0988888888
VIETQR_ACCOUNT_NAME=QUAN NGUYEN S

# ── 7. TỰ ĐỘNG HÓA CHĂM SÓC TOÀN VÒNG ĐỜI (OUTBOUND SCHEDULER) ──
# Bật kiểm tra định kỳ 24/7 (nhắc giỏ hàng, xác nhận nhận hàng, v.v.)
OUTBOUND_ENABLED=true
QUIET_HOURS_START=20:00
QUIET_HOURS_END=09:00
MARKETING_MAX_7D=1
MARKETING_MAX_30D=3
