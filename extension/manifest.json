{
  "manifest_version": 3,
  "name": "QuanNguyenS CSKH Co-Pilot — Trợ Lý May",
  "version": "1.0.0",
  "description": "Trợ lý AI bán tự động hỗ trợ chăm sóc khách hàng 24/7 trên Meta Business Suite, Messenger và Instagram cho thương hiệu QuanNguyenS.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "QuanNguyenS CSKH Co-Pilot — May",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "http://localhost:3002/*",
    "http://127.0.0.1:3002/*",
    "https://business.facebook.com/*",
    "https://*.facebook.com/*",
    "https://*.instagram.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://business.facebook.com/*",
        "https://*.facebook.com/messages/*",
        "https://*.instagram.com/direct/*"
      ],
      "js": ["content.js"],
      "css": ["style.css"],
      "run_at": "document_idle"
    }
  ]
}
